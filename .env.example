# Copy this file to .env and fill locally. Never commit .env.
# Full OpenAI-compatible Chat Completions endpoint, typically ending /v1/chat/completions.
CHAT_API_URL=https://api.deepseek.com/chat/completions
CHAT_API_KEY=
CHAT_MODEL=deepseek-flash
CHAT_PROVIDER=deepseek
# Optional: limit each IP to N requests per hour. Defaults to 30.
CHAT_RATE_LIMIT=30
# Local development: keep 127.0.0.1. In a container or on Render use 0.0.0.0.
HOST=127.0.0.1
PORT=4177
# Optional for a split deployment (GitHub Pages frontend + separate API host).
# For the recommended same-origin Render deployment, leave empty.
PUBLIC_ORIGIN=

# Anonymous guestbook: server-only Supabase secret key. Run supabase/guestbook.sql first.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Full public origin, no trailing slash.
SITE_URL=https://neon-lab.onrender.com
